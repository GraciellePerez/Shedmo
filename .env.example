# Public client configuration only. Never place a service-role key in an Expo app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Stripe test-mode publishable key only. Never use an sk_test_ or live-mode key.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Default launch mode: local transactions. Both flags are needed for test checkout.
EXPO_PUBLIC_ENABLE_PUBLIC_SHIPPING=false
EXPO_PUBLIC_ENABLE_PROTECTED_CHECKOUT=false

# Backend-only configuration belongs in a separate ignored function env file.
# These are variable names and placeholders, never values for the mobile bundle.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=replace-with-backend-client-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
# STRIPE_SECRET_KEY=replace-with-stripe-test-secret
# STRIPE_WEBHOOK_SIGNING_SECRET=replace-with-webhook-signing-secret
# CONNECT_ONBOARDING_RETURN_URL=https://your-project-ref.supabase.co/functions/v1/connect-onboarding-return-redirect
# CONNECT_ONBOARDING_REFRESH_URL=https://your-project-ref.supabase.co/functions/v1/connect-onboarding-refresh-redirect
# PUSH_WEBHOOK_SECRET=replace-with-push-webhook-secret
# EASYPOST_API_KEY=replace-with-provider-test-key
# EASYPOST_WEBHOOK_SECRET=replace-with-provider-webhook-secret
# ENABLE_PUBLIC_SHIPPING=false
# ENABLE_PROTECTED_CHECKOUT=false
# CONNECT_DIAGNOSTIC_LOGGING=false

# Optional local-only account-deletion runtime test configuration, supplied
# separately to the test process. Never use hosted credentials here.
# SHEDMO_DELETION_TEST_URL=http://127.0.0.1:54321
# SHEDMO_DELETION_TEST_ANON_KEY=replace-with-local-client-key
# SHEDMO_DELETION_TEST_SERVICE_ROLE_KEY=replace-with-local-server-key
