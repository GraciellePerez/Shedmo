{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "supabase/functions/**",
    "scripts/tests/payout-recovery.test.ts",
    "scripts/tests/processing-fee-recovery.test.ts",
    "scripts/tests/refund-recovery.test.ts"
  ]
}
