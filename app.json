{
  "expo": {
    "name": "Shedmo",
    "slug": "ProjectMarketplaceMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/shedmo-icon.png",
    "scheme": "shedmo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/shedmo-icon.png",
      "bundleIdentifier": "com.gracielleperez.shedmo",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gracielleperez.shedmo",
      "adaptiveIcon": {
        "backgroundColor": "#EF3538",
        "foregroundImage": "./assets/shedmo-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/shedmo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EF3538",
          "image": "./assets/shedmo-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Shedmo to select photos for chat messages, profile pictures, listings, and dispute evidence.",
          "cameraPermission": "Allow Shedmo to take photos for marketplace listings.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Shedmo to use your location to show approximate listing distances."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Shedmo to take photos for marketplace listings.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e1024a7-b051-467f-8a3c-8fa9d1060256"
      }
    }
  }
}
